<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <title>Delivery Challan</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      margin: 20px;
    }

    .header {
      text-align: center;
      font-weight: bold;
      font-size: 18px;
      margin-bottom: 20px;
      text-transform: uppercase;
    }

    .company-logo {
      width: 160px;
      height: auto;
      object-fit: contain;
    }

    .company-details {
      display: flex;
      justify-content: space-between;
      margin-bottom: 20px;
    }

    .company-info {
      text-align: left;
    }

    .info-box {
      border: 2px solid black;
      display: flex;
      margin-top: 10px;
    }

    .info-left {
      width: 60%;
      padding: 10px;
      border-right: 2px solid black;
    }

    .info-right {
      width: 40%;
      padding: 10px;
      text-align: left;
    }

    .info-right table {
      width: 100%;
      border: none;
    }

    .info-right table td {
      padding: 4px;
      border: none;
      vertical-align: top;
    }

    .left-align {
      text-align: left;
    }


    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
      font-size: 12px;
    }

    th,
    td {
      border: 1px solid black;
      padding: 5px;
      text-align: center;
    }

    .note {
      margin-top: 10px;
      font-size: 12px;
      font-weight: bold;
      text-align: center;
      background: #f0f0f0;
      padding: 5px;
      border: 1px dashed gray;
    }

    .eway-container {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-top: 15px;
    }

    .eway-left {
      width: 35%;
      text-align: center;
    }

    .eway-right {
      width: 60%;
      font-size: 12px;
    }

    /* .watermark {
      position: fixed;
      top: 20;
      left: 0;
      right: 0;
      bottom: 0;
      font-size: 120px;
      user-select: none;
      font-weight: bold;
      text-align: center;
      line-height: 100vh;
      transform: rotate(-45deg);
      z-index: -1;
      pointer-events: none;
    } */


    .watermark {
      position: fixed;
      top: 20%;
      left: 0;
      right: 0;
      font-size: 120px;
      user-select: none;
      font-weight: bold;
      text-align: center;
      transform: rotate(-45deg);
      z-index: -1;
      pointer-events: none;
      line-height: normal;
    }
    
  </style>
</head>

<body>

  <div class="header">Delivery Challan</div>

  <div class="company-details">
    <img class="company-logo" src="https://i.postimg.cc/L5VKhNt5/Logo-2.png" alt="Krishi Logo" />
    <div class="company-info">
      <div><b>KRISHI NUTRITION COMPANY PRIVATE LIMITED</b></div>
      <div>Regd. Office : Plot No. KK8, KK9, 3rd Cross Street Road,</div>
      <div>Sipcot Industrial Growth Center</div>
      <div>PERUNDURAI - 638052, Erode, Tamil Nadu</div>
      <div>CIN : U15200TZ2013PTC019958</div>
      <div>GSTIN : 33AAFCK3415K1ZO</div>
    </div>
  </div>

  <!-- Single box: Dispatch + Ship on Left, Doc info on Right -->
  <div class="info-box">
    <div class="info-left">
      <b>Dispatch From</b><br>
      <!-- KRISHI NUTRITION COMPANY PRIVATE LIMITED<br>
      Erode Goodshed, Erode, Tamilnadu - 638002<br><br> -->
      <%= full_from_address.company %><br>
        <%= full_from_address.door_no %>
          <%= full_from_address.street %><br>
            <%= full_from_address.city %>, <%= full_from_address.state %> - <%= full_from_address.pincode %><br>
                GSTIN : <%= full_from_address.gst_in %>

                  <br>
                  <br>

                  <b>Billed / Ship to</b><br>
                  <%= full_address.company %><br>
                    <%= full_address.door_no %>
                      <%= full_address.street %><br>
                        <%= full_address.city %>, <%= full_address.state %> - <%= full_address.pincode %><br>
                            GSTIN : <%= full_address.gst_in %>
    </div>

    <div class="info-right">
      <table>
        <tr>
          <td class="left-align"><b>Doc No.</b></td>
          <td class="left-align">
            <%= doc_no %>
          </td>
        </tr>
        <tr>
          <td class="left-align"><b>Date</b></td>
          <td class="left-align">
            <%= new Date(created_at).toLocaleString('en-GB', { day: '2-digit' , month: '2-digit' , year: 'numeric' ,
              hour: '2-digit' , minute: '2-digit' , second: '2-digit' }).replace(',', '' ) %>

          </td>
        </tr>
        <tr>
          <td class="left-align"><b>RR No</b></td>
          <td class="left-align">
            <%= rr_no %>
          </td>
        </tr>
        <tr>
          <td class="left-align"><b>Ref Po.</b></td>
          <td class="left-align">
            <%= po_no %>
          </td>
        </tr>
        <tr>
          <td class="left-align"><b>Ref Bill No.</b></td>
          <td class="left-align">
            <%= bill_no %>
          </td>
        </tr>
        <tr>
          <td class="left-align"><b>Truck No.</b></td>
          <td class="left-align">
            <%= truck_no %>
          </td>
        </tr>
      </table>
    </div>
  </div>
  

  <table>
  
    <thead>
      <tr>
        <th colspan="4" style="border: none;"></th>
        <th colspan="6" style="border: none; text-align: left; font-size: 12px; font-weight: bold; margin-bottom:8px;">
        <span style="color:red;">*</span> Amount in INR
        </th>
      </tr>

    
      <tr>
        <th>Material</th>
        <th>HSN Code</th>
        <th>No of Bag</th>
        <th>Qty (MTS)</th>
        <th>Rate (Inc of Tax)</th>
        <th>Basic</th>
        <th>CGST 2.5%</th>
        <th>SGST 2.5%</th>
        <th>Round Off</th>
        <th>Total</th>
      </tr>
    </thead>
    <tbody>

      <!-- <% var e_way_bill=null; %> -->

      <% materials.forEach(function(material){ %>

        <tr>
          <td>
            <%= material.name %>
          </td>
          <td>
            <%= material.hsn_code %>
          </td>
          <td>
            <%= material.noOfBags %>
          </td>
          <td>
            <%= material.quantity %>
          </td>
          <td>
            <%= material.price %>
          </td>
          <td>
            <%= material.basic %>
          </td>
          <td>
            <%= material.cgstAmount %>
          </td>
          <td>
            <%= material.sgstAmount %>
          </td>
          <td>
            <%= (Math.round(Number(material.total || 0)) - Number(material.total || 0)).toFixed(2) %>
          </td>

          <td>
            <%= Math.round(Number(material.total || 0)) %>
          </td>
          <!-- <% e_way_bill=material.e_way_bill; %> -->
        </tr>

        <% }) %>
    </tbody>
  </table>

  <% if(!isEwayBill) { %>

    <% if(isEwayExemption) { %>
      <p style="text-align: center; margin-top: 20px; margin-bottom: 20px;">
        Exemption from generation of E-Way Bill: Rule 138(14)(e) of Central Goods and Service Tax Rules, 2017 exempts from
        the requirement of E-Way Bill generation for Goods except De-oiled cake specified in theSchedule appended to
        Notification No. 2/2017 Central Tax (Rate) dt.28.06.17. Goods included in this Delivery Challan (ST) are exempt as
        per the said Notification and hence E-Way Bill is not generated
      </p>
    <% } %>

    <div class="note">
      This is a system generated document, hence no signature is required.
    </div>

    <!-- <div class="watermark" style="color: rgba(0, 0, 0, 0.1);">
      KRISHI
    </div> -->


    <% } else { %>

      <div class="note">
        This is a system generated document, hence no signature is required.
      </div>

      <% if(!viewMode) { %>
      <div class="eway-container">
        <div class="eway-left">
          <b>e-Way Bill</b><br>
          <img
            src="https://api.qrserver.com/v1/create-qr-code/?size=120x120&data=<%= e_way_data.e_way_bill_no %> | <%= e_way_data.data %> | <%= e_way_data.valid %>"
            alt="QR Code" width="120" height="120">
        </div>
        <div class="eway-right">
          <p><b>eWay Bill No:</b>
            <%= e_way_data.e_way_bill_no %>
          </p>
          <p><b>Type:</b> Inward - For Own Use</p>
          <p><b>Generated Date:</b>
            <%= e_way_data.date %>
          </p>
          <p><b>Valid Upto:</b>
            <%= e_way_data.valid %>
          </p>
          <p><b>Transaction type:</b> Regular</p>
        </div>
      </div>
      <% } %>

      <% } %>

    
     
      <div class="watermark"
        style="<%
          let label = '';
          const now = new Date();

          // Highest priority: CANCELLED
          if (status && status.trim().toLowerCase() === 'cancelled') {
            label = 'CANCELLED';
          } 
          // Next: No e-way bill → always KRISHI
          else if (!isEwayBill) {
            label = 'KRISHI';
          } 
          // Else: e-way bill exists → apply expiry logic
          else {
          label = 'KRISHI';
          }

          const watermarkColor =
            (label === 'EXPIRED' || label === 'CANCELLED')
              ? 'rgba(252, 192, 192, 0.603)'
              : 'rgba(0, 0, 0, 0.1)';
        %>
        color:<%= watermarkColor %>;">
        <%= label %>
      </div>




</body>

</html>